# Configure route back to VPN

$cmd = ['ip','route','add'];

if ( array_key_exists('VPN_CONCENTRATOR_IP', $_ENV)) {
    if ( array_key_exists('VPN_NETWORK', $_ENV) && ($_ENV['VPN_CONCENTRATOR_IP']!= "127.0.0.1") ) {
        echo "Configuration of route to VPN users\n";
        echo "Configuration of route to ".$_ENV['VPN_NETWORK']." ".$_ENV['VPN_NETWORK_NETMASK']." via ".$_ENV['VPN_CONCENTRATOR_IP']."\n";
        $base_ip = new IP($_ENV['VPN_NETWORK']);
        $vpn_network = new Network($base_ip, $_ENV['VPN_NETWORK_NETMASK']);
        $cmd[]=$vpn_network->__toString();
        $cmd[]='via';
        $cmd[]=$_ENV['VPN_CONCENTRATOR_IP'];
        
        $process = new Process($cmd);
        $process->setTimeout(null);
        $process->run(function ($type, $buffer) {
        echo $buffer;
        });
    }

    # Labs now route through table 4 (policy routing added by
    # InstanceManager::connectToInternet). The VPN network must also be present
    # in table 4 : otherwise a lab talking to a VPN user would fall back on the
    # default route (towards the ISP) instead of being sent to the front server
    # which hosts the VPN concentrator. The route points to the front admin IP
    # (FRONT_SERVER_IP) reachable through ADM_INTERFACE.
    if ( array_key_exists('VPN_NETWORK', $_ENV)
        && array_key_exists('FRONT_SERVER_IP', $_ENV)
        && array_key_exists('ADM_INTERFACE', $_ENV)
        && ($_ENV['VPN_CONCENTRATOR_IP'] != "127.0.0.1")
        ) {
        $base_ip = new IP($_ENV['VPN_NETWORK']);
        $vpn_network = new Network($base_ip, $_ENV['VPN_NETWORK_NETMASK']);
        $vpnRoute = $vpn_network->__toString() . ' via ' . $_ENV['FRONT_SERVER_IP'] . ' dev ' . $_ENV['ADM_INTERFACE'];
        echo "Configuration of route to VPN users in table 4\n";
        echo "Configuration of route to " . $vpn_network->__toString() . " via " . $_ENV['FRONT_SERVER_IP'] . " dev " . $_ENV['ADM_INTERFACE'] . " table 4\n";
        if (!IPTools::routeExists($vpnRoute, 4)) {
            IPTools::routeAdd($vpnRoute, 4);
        }
    }

    if ( array_key_exists('VPN_NETWORK', $_ENV)) {
        echo "Configuration of iptables to allow forward to VPN users\n";
        echo "Forward from and to network ".$_ENV['VPN_NETWORK']." ".$_ENV['VPN_NETWORK_NETMASK']." is allowed\n";
        $base_ip = new IP($_ENV['VPN_NETWORK']);
        $vpn_network = new Network($base_ip, $_ENV['VPN_NETWORK_NETMASK']);
        $rule=Rule::create()
            ->setSource($vpn_network->__toString())
            ->setJump('ACCEPT');
        
        if (!IPTables::exists(IPTABLES::CHAIN_FORWARD,$rule)) {
            IPTables::append(
                IPTABLES::CHAIN_FORWARD,
                $rule
            );
        }

        $rule=Rule::create()
            ->setDestination($vpn_network->__toString())
            ->setJump('ACCEPT');
        
        if (!IPTables::exists(IPTABLES::CHAIN_FORWARD,$rule)) {
            IPTables::append(
                IPTABLES::CHAIN_FORWARD,
                $rule
            );
        }
    }
}

// Autoriser les connexions établies et associées
    $rule = Rule::create()
        ->setProtocol(Rule::PROTOCOL_ALL)
        ->setStates(['ESTABLISHED', 'RELATED'])
        ->setJump('ACCEPT');
    if (!IPTables::exists(IPTables::CHAIN_FORWARD,$rule)) {
        IPTables::append(
            IPTables::CHAIN_FORWARD,
            $rule
        );
    }

# Internet connexion is now handled per lab : InstanceManager::connectToInternet()
# adds one MASQUERADE rule per lab (source = the lab's own subnet) and
# disconnectFromInternet() removes it and blocks the lab's outgoing traffic.
# No global MASQUERADE rule on LAB_NETWORK here : it would give internet access
# to every lab whether it is connected or not.
#
# Only clean up the leftover global rule from older versions (a broad
# `iptables -t nat -F` would also wipe the per-lab rules of running labs).
$globalNatRule = null;
if ( array_key_exists('INTERNET_INTERFACE_ACCESS', $_ENV) && array_key_exists('LAB_NETWORK', $_ENV) ) {
    $globalNatRule = Rule::create()
        ->setSource($_ENV['LAB_NETWORK'])
        ->setOutInterface($_ENV['INTERNET_INTERFACE_ACCESS'])
        ->setDestination($_ENV['LAB_NETWORK'])
        ->setDestinationNegated()
        ->setJump('MASQUERADE');
}

if ( $globalNatRule !== null && IPTables::exists(IPTables::CHAIN_POSTROUTING, $globalNatRule, 'nat') ) {
    echo "Removing legacy global MASQUERADE rule (internet is now per lab)\n";
    IPTables::delete(IPTables::CHAIN_POSTROUTING, $globalNatRule, 'nat');
}


# Configure iptables to DROP all packet in forward to avoid communication between lab
$cmd = ['iptables','-P','FORWARD','DROP'];
$process = new Process($cmd);
$process->setTimeout(null);

$process->run(function ($type, $buffer) {
    echo $buffer;
});



